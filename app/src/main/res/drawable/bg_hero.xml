<?xml version="1.0" encoding="utf-8"?>
<!-- The home header: paper with the faintest green wash, so the content carries the screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/brand_green_tint"
        android:endColor="@color/paper"
        android:type="linear" />
    <corners
        android:bottomLeftRadius="28dp"
        android:bottomRightRadius="28dp" />
</shape>
