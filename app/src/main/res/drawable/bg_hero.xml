<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/sky_top"
                android:centerColor="@color/brand_green_deep"
                android:endColor="@color/brand_teal"
                android:type="linear" />
            <corners
                android:bottomLeftRadius="34dp"
                android:bottomRightRadius="34dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.85"
                android:centerY="0.12"
                android:gradientRadius="64%p"
                android:startColor="#4DE3B662"
                android:endColor="#00000000" />
            <corners
                android:bottomLeftRadius="34dp"
                android:bottomRightRadius="34dp" />
        </shape>
    </item>
</layer-list>
