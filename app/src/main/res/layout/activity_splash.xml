<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <!-- Scrolls so the wordmark never clips on a short screen or in landscape. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="32dp">

            <FrameLayout
                android:layout_width="190dp"
                android:layout_height="190dp">

                <com.afzal.rozaalarm.ui.view.PulseRingView
                    android:id="@+id/splashPulse"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/splashLogo"
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_app_logo"
                    android:src="@drawable/logo_roza" />
            </FrameLayout>

            <TextView
                android:id="@+id/splashTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.02"
                android:text="@string/app_name"
                android:textColor="@color/brand_green_dark"
                android:textSize="28sp" />

            <View
                android:id="@+id/splashRule"
                android:layout_width="56dp"
                android:layout_height="1.5dp"
                android:layout_marginTop="14dp"
                android:background="@color/brand_gold" />

            <TextView
                android:id="@+id/splashTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.14"
                android:text="@string/app_tagline"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/splashBismillah"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.6"
                android:text="@string/bismillah"
                android:textColor="@color/brand_gold"
                android:textSize="18sp" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/splashProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="110dp"
        android:layout_height="3dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="@color/hairline"
        android:progressTint="@color/brand_green"
        tools:ignore="UnusedAttribute" />
</FrameLayout>
