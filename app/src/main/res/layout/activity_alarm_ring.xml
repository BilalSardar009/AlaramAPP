<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ringRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_gold_tint">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="48dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/ringClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="64sp"
                tools:text="3:00 AM" />

            <TextView
                android:id="@+id/ringDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/ink_muted"
                android:textSize="14sp"
                tools:text="Friday, 13 November 2026" />

            <TextView
                android:id="@+id/ringHijri"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/brand_green"
                android:textSize="13sp"
                tools:text="13 Jumada al-Ula 1448 AH · ۱۳ جمادی الاول ۱۴۴۸ھ" />

            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginTop="20dp">

                <com.afzal.rozaalarm.ui.view.PulseRingView
                    android:id="@+id/ringPulse"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/ringLogo"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_app_logo"
                    android:src="@drawable/logo_roza" />
            </FrameLayout>

            <TextView
                android:id="@+id/ringLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:textColor="@color/brand_green_dark"
                android:textSize="24sp"
                tools:text="Ayyam al-Beed Sehri" />

            <TextView
                android:id="@+id/ringMessageEnglish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="16sp"
                tools:text="Suhoor time — your fasting alarm is ringing." />

            <TextView
                android:id="@+id/ringMessageUrdu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.5"
                android:textColor="@color/brand_gold"
                android:textSize="17sp"
                tools:text="سحری کا وقت ہو گیا ہے — روزے کا الارم بج رہا ہے۔" />

            <!-- Full width and stacked: nothing to truncate, nothing to mis-align, and both are
                 easy to hit half asleep. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/snoozeButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:minHeight="58dp"
                android:textColor="@color/brand_green_dark"
                android:textSize="16sp"
                app:cornerRadius="29dp"
                app:icon="@drawable/ic_snooze"
                app:iconGravity="textStart"
                app:iconTint="@color/brand_green"
                app:strokeColor="@color/brand_green"
                tools:text="Snooze 5 min" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dismissButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="58dp"
                android:text="@string/ring_dismiss"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:backgroundTint="@color/brand_green"
                app:cornerRadius="29dp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
